# Copy to .env and fill in. Used by docker compose (local production-like run).
# The deployed app gets the same variables from the Render dashboard (docs/DEPLOYMENT.md).

# ===== Local MySQL (docker compose only) =====
MYSQLDB_DATABASE=
MYSQLDB_ROOT_PASSWORD=
MYSQLDB_LOCAL_PORT=3308
MYSQLDB_DOCKER_PORT=3306

SPRING_LOCAL_PORT=8081
SPRING_DOCKER_PORT=8080
DEBUG_PORT=5006

# ===== Dropbox =====
# Long-lived: refresh token + app key + app secret (docs/DEPLOYMENT.md, step "Dropbox")
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Optional fallback: a short-lived token from the Dropbox console (~4 hours)
DROPBOX_ACCESS_TOKEN=

# ===== Security =====
# JWT_SECRET: at least 32 random characters
JWT_SECRET=
# SECURITY_ENCRYPTION_SALT: hex string, for example the output of `openssl rand -hex 8`
SECURITY_ENCRYPTION_SECRET=
SECURITY_ENCRYPTION_SALT=

# ===== Integrations =====
TELEGRAM_BOT_TOKEN=
