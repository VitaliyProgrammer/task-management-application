# Copy to .env.local and adjust if needed.

# Backend URL. Leave empty in development: Vite forwards /api to http://localhost:8080.
# In production set it to the deployed API, for example https://api.alijenta.dev
VITE_API_URL=

# Demo account shown on the login page (created by the backend Liquibase "demo" context)
VITE_DEMO_EMAIL=demo@alijenta.dev
VITE_DEMO_PASSWORD=Alijenta2026
